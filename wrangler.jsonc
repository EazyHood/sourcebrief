{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sourcebrief",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./live-dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": false }
}
